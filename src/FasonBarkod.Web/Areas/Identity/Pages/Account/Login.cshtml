@page
@model FasonBarkod.Web.Areas.Identity.Pages.Account.LoginModel
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Giriş";
}

<div class="login-wrapper">
    <div class="login-card shadow">
        <div class="login-card-header text-center">
            <div class="login-logo">Fason Barkod</div>
            <p class="login-subtitle mb-0">SAS barkod etiket basımı</p>
        </div>

        <div class="login-card-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username"
                           placeholder="ornek@fason.local" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password"
                           placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Giriş Yap</button>
            </form>

            @if (HostEnvironment.IsDevelopment())
            {
                <div class="login-dev-hint mt-4">
                    <div class="small text-muted fw-semibold mb-2">Geliştirme ortamı test hesapları</div>
                    <table class="table table-sm table-borderless mb-0 small">
                        <tr>
                            <td class="text-muted">Operatör</td>
                            <td><code>operator@fason.local</code></td>
                            <td><code>Operator123!</code></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Admin</td>
                            <td><code>admin@fason.local</code></td>
                            <td><code>Admin123!</code></td>
                        </tr>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
