@model OrderDetailViewModel
@{
    ViewData["Title"] = $"Sipariş {Model.SalesOrderNo}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Siparişler</a></li>
        <li class="breadcrumb-item active">@Model.SalesOrderNo</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="h3">Sipariş @Model.SalesOrderNo</h1>
    <p class="text-muted mb-0">
        Müşteri: <strong>@Model.CustomerName</strong> |
        Tarih: <strong>@(Model.OrderDate?.ToString("dd.MM.yyyy") ?? "-")</strong>
    </p>
</div>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Malzeme Kodu</th>
                <th>Malzeme Adı</th>
                <th>Renk</th>
                <th class="text-end">Miktar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.MaterialCode</td>
                <td>@line.MaterialName</td>
                <td>@line.Color</td>
                <td class="text-end">@line.Quantity.ToString("N0")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-success" asp-controller="BarcodePrints" asp-action="Create" asp-route-orderLineId="@line.Id">
                        Etiket Bas
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
