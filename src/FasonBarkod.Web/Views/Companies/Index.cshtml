@model List<CompanyListItemViewModel>
@{
    ViewData["Title"] = "Şirketler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Şirketler</h1>
        <p class="text-muted mb-0">Her şirket kendi kullanıcılarını yönetir; şirketler birbirini görmez.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni Şirket</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Ad</th>
                <th>Kod</th>
                <th>Kullanıcı</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td><code>@item.Code</code></td>
                <td>@item.UserCount</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge text-bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Pasif</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
