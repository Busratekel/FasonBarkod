<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Fason Barkod</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/FasonBarkod.Web.styles.css" asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand fw-semibold" asp-controller="Sas" asp-action="Index">Fason Barkod</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"

                        aria-expanded="false" aria-label="Menü">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity?.IsAuthenticated == true)

                        {

                            <li class="nav-item">

                                <a class="nav-link text-white" asp-controller="Sas" asp-action="Index">SAS</a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-white" asp-controller="BarcodePrints" asp-action="Index">Basım Geçmişi</a>

                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="PrintSettings" asp-action="Index">Yazıcı</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="LabelTemplates" asp-action="Index">Etiket Tasarımları</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Operator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
                                </li>
                            }

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Companies" asp-action="Index">Şirketler</a>
                                </li>
                            }

                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>



    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Fason Barkod

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewBag.QzTrayEnabled == true)
    {
        @if (ViewBag.QzCertificatePem is string qzCert && !string.IsNullOrWhiteSpace(qzCert))
        {
            <script>
                window.FASON_QZ_CERT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(qzCert));
            </script>
        }
        <script src="~/lib/qz/qz-tray.js" asp-append-version="true"></script>
        <script src="~/js/fason-qz.js" asp-append-version="true"></script>
        <div id="qz-print-toast" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080; display: none;">
            <div class="toast show align-items-center text-bg-dark border-0" role="status">
                <div class="d-flex">
                    <div class="toast-body" id="qz-print-toast-body">Yazdırılıyor…</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="document.getElementById('qz-print-toast').style.display='none'"></button>
                </div>
            </div>
        </div>
        <script>
            (function () {
                var pending = @Html.Raw(ViewBag.QzPendingJobsJson as string ?? "null");
                var printIds = @Html.Raw(ViewBag.QzPendingPrintIdsJson as string ?? "null");
                if (!pending || !window.FasonQz) return;

                var toast = document.getElementById('qz-print-toast');
                var body = document.getElementById('qz-print-toast-body');
                function show(msg, ok) {
                    if (!toast || !body) return;
                    body.textContent = msg;
                    toast.style.display = 'block';
                    toast.querySelector('.toast').className =
                        'toast show align-items-center border-0 ' + (ok ? 'text-bg-success' : 'text-bg-danger');
                }

                function confirmStatus(ok, errMsg) {
                    if (!printIds || !printIds.length) return;
                    fetch('@Url.Action("ConfirmQzPrint", "BarcodePrints")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify({ ids: printIds, success: !!ok, errorMessage: errMsg || null })
                    }).catch(function () { /* durum güncellemesi sessizce başarısız olabilir */ });
                }

                show('QZ Tray ile yazdırılıyor…', true);
                FasonQz.printBase64Jobs(pending)
                    .then(function (r) {
                        confirmStatus(true);
                        show(r.count + ' etiket gönderildi: ' + r.printer, true);
                        setTimeout(function () { toast.style.display = 'none'; }, 5000);
                    })
                    .catch(function (err) {
                        var msg = err && err.message ? err.message : String(err);
                        confirmStatus(false, msg);
                        show('Yazdırma hatası: ' + msg, false);
                    });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

