@using FasonBarkod.Core.Entities
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link text-white-50 small">@User.Identity?.Name</span>
    </li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Sas")">
            <button type="submit" class="btn btn-outline-light btn-sm ms-1">Çıkış</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Giriş</a>
    </li>
}
</ul>
