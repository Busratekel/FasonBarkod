@model CreateBarcodePrintViewModel
@{
    ViewData["Title"] = "Etiket Basım";
}

<h1 class="h3 mb-3">Etiket Basım</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3">Sipariş</dt>
            <dd class="col-sm-9">@Model.SalesOrderNo</dd>
            <dt class="col-sm-3">Malzeme</dt>
            <dd class="col-sm-9">@Model.MaterialCode - @Model.MaterialName</dd>
            <dt class="col-sm-3">Sipariş Miktarı</dt>
            <dd class="col-sm-9">@Model.MaxQuantity.ToString("N0")</dd>
        </dl>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="OrderLineId" />
            <input type="hidden" asp-for="SalesOrderNo" />
            <input type="hidden" asp-for="MaterialCode" />
            <input type="hidden" asp-for="MaterialName" />
            <input type="hidden" asp-for="MaxQuantity" />

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" style="max-width: 200px;" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="alert alert-warning">
                Yazıcı entegrasyonu henüz eklenmedi. Kayıt oluşturulacak; ZPL/EPL basımı sonraki adımda eklenecek.
            </div>

            <button type="submit" class="btn btn-success">Barkod Oluştur</button>
            <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Detail" asp-route-id="@Model.SalesOrderNo">Geri</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
