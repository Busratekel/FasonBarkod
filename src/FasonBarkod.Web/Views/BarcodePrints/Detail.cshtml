@model BarcodePrint
@using FasonBarkod.Core.Enums
@{
    ViewData["Title"] = Model.BarcodeNo;
}

<h1 class="h3 mb-3">Etiket Detayı</h1>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">Etiket Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Barkod No</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.BarcodeNo</dd>
                    <dt class="col-sm-4">Sipariş</dt>
                    <dd class="col-sm-8">@Model.SalesOrderNo @(!string.IsNullOrWhiteSpace(Model.LineNo) ? $"/ {Model.LineNo}" : "")</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.VendorCode))
                    {
                        <dt class="col-sm-4">Satıcı Kodu</dt>
                        <dd class="col-sm-8">@Model.VendorCode</dd>
                    }
                    @if (Model.LabelType.HasValue)
                    {
                        <dt class="col-sm-4">Etiket Tipi</dt>
                        <dd class="col-sm-8">@(Model.LabelType == LabelType.KoliUstu ? "Koli Üstü" : "Koli İçi")</dd>
                    }
                    <dt class="col-sm-4">Malzeme</dt>
                    <dd class="col-sm-8">@Model.MaterialCode @Model.MaterialName</dd>
                    <dt class="col-sm-4">Adet</dt>
                    <dd class="col-sm-8">@Model.Quantity.ToString("N0")</dd>
                    <dt class="col-sm-4">Basım Tarihi</dt>
                    <dd class="col-sm-8">@Model.PrintDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Basan</dt>
                    <dd class="col-sm-8">@(Model.PrintedByUser?.FullName ?? Model.PrintedByUser?.Email ?? "-")</dd>
                    <dt class="col-sm-4">SAP Durumu</dt>
                    <dd class="col-sm-8">@(Model.SapSent ? "Gönderildi" : "Henüz gönderilmedi")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">SAP Gönderim Logları</div>
            <div class="card-body">
                @if (Model.TransferLogs.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var log in Model.TransferLogs)
                        {
                            <li class="list-group-item px-0">
                                <div class="small text-muted">@log.TransferDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") — @log.Result</div>
                                @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                                {
                                    <div class="text-danger small">@log.ErrorMessage</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(log.RequestPayload))
                                {
                                    <div class="small mt-1">@log.RequestPayload</div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Log kaydı yok.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="Index">Basım Geçmişi</a>
    <a class="btn btn-outline-secondary" asp-controller="Sas" asp-action="Detail" asp-route-id="@Model.SalesOrderNo">SAS Ekranına Dön</a>
</div>
