@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
    var isSuperAdmin = ViewBag.IsSuperAdmin as bool? == true;
    var canManageUsers = ViewBag.CanManageUsers as bool? == true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Kullanıcılar</h1>
        <p class="text-muted mb-0">
            @if (isSuperAdmin)
            {
                <text>Tüm şirketlerin kullanıcıları. SuperAdmin hesaplarını yalnızca SuperAdmin düzenleyebilir.</text>
            }
            else if (canManageUsers)
            {
                <text>Kendi şirketinizdeki kullanıcılar. SuperAdmin satırları görünür ama düzenlenemez.</text>
            }
            else
            {
                <text>Kullanıcı listesi salt okunur. SuperAdmin satırları düzenlenemez.</text>
            }
        </p>
    </div>
    @if (canManageUsers)
    {
        <a class="btn btn-primary" asp-action="Create">Yeni Kullanıcı</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>E-posta</th>
                <th>Ad Soyad</th>
                @if (isSuperAdmin)
                {
                    <th>Şirket</th>
                }
                <th>Satıcı Kodu</th>
                <th>Rol</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var isSuperRow = item.Role == "SuperAdmin";
            <tr class="@(!item.CanManage ? "table-secondary text-muted" : null)">
                <td>@item.Email</td>
                <td>@(string.IsNullOrWhiteSpace(item.FullName) ? "—" : item.FullName)</td>
                @if (isSuperAdmin)
                {
                    <td>@(string.IsNullOrWhiteSpace(item.CompanyName) ? "—" : item.CompanyName)</td>
                }
                <td>@(string.IsNullOrWhiteSpace(item.VendorCode) ? "—" : item.VendorCode)</td>
                <td>
                    @if (isSuperRow)
                    {
                        <span class="badge text-bg-dark">SuperAdmin</span>
                    }
                    else if (item.Role == "Admin")
                    {
                        <span class="badge text-bg-primary">Admin</span>
                    }
                    else if (item.Role == "Operator")
                    {
                        <span class="badge text-bg-secondary">Operatör</span>
                    }
                    else
                    {
                        @item.Role
                    }
                </td>
                <td>
                    @if (!item.CanManage && isSuperRow)
                    {
                        <span class="badge text-bg-secondary">Pasif (salt okunur)</span>
                    }
                    else if (item.IsActive)
                    {
                        <span class="badge text-bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Pasif</span>
                    }
                </td>
                <td class="text-nowrap">
                    @if (item.CanManage)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@item.Id">Şifre</a>
                    }
                    else
                    {
                        <span class="small">—</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
