@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Şifre Sıfırla</h1>
    <p class="text-muted mb-0">@Model.Email</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post" class="row g-3" style="max-width: 420px;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="col-12">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
                <a class="btn btn-outline-secondary" asp-action="Index">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
