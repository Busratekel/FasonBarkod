@model EditUserViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    var roles = (ViewBag.Roles as string[]) ?? ["Admin", "Operator"];
    var isSuperAdmin = ViewBag.IsSuperAdmin as bool? == true;
}

<div class="mb-3">
    <h1 class="h3 mb-1">Kullanıcı Düzenle</h1>
    <p class="text-muted mb-0">@Model.Email</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3" style="max-width: 520px;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" disabled />
            </div>

            <div class="col-12">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            @if (isSuperAdmin)
            {
                <div class="col-12">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.Companies">
                        <option value="">— Şirket seçin —</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger small"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="CompanyId" />
                <div class="col-12">
                    <label class="form-label">Şirket</label>
                    <input class="form-control" value="@(ViewBag.CompanyName as string ?? "")" disabled />
                </div>
            }

            <div class="col-12">
                <label asp-for="VendorCode" class="form-label"></label>
                <input asp-for="VendorCode" class="form-control" inputmode="numeric" autocomplete="off" />
                <div class="form-text">Operatör için zorunlu. Admin için boş bırakılabilir.</div>
                <span asp-validation-for="VendorCode" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in roles)
                    {
                        <option value="@role">@(role == "Operator" ? "Operatör" : role)</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <span asp-validation-for="IsActive" class="text-danger small"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a class="btn btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@Model.Id">Şifre Sıfırla</a>
                <a class="btn btn-outline-secondary" asp-action="Index">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
