@model SasDetailViewModel
@using FasonBarkod.Core.Sap
@{
    ViewData["Title"] = $"SAS {Model.PurchaseOrderNo}";
    var selected = Model.SelectedLine;
    var isAdmin = User.IsInRole("Admin");
    var orderQty = Model.OrderQuantity > 0 ? Model.OrderQuantity : (selected?.Quantity ?? 0);
    var originalPkg = Model.OriginalPackageQuantity > 0
        ? Model.OriginalPackageQuantity
        : (selected?.PackageQuantity ?? 0);
    var pkg = Model.PackageQuantity;
    var printedBox = selected?.PrintedBoxCount ?? 0;
    var printedInside = selected?.PrintedInsideBoxCount ?? 0;
    // Koli içi kota hesabında paket>MENGE ise efektif paket = MENGE (SAP'ye de böyle gider).
    var pkgForInside = orderQty > 0 && pkg > orderQty ? orderQty : pkg;
    var remainingInside = PackageQuantityValidator.RemainingInsideQuantity(
        orderQty, pkgForInside, printedBox, printedInside);
    var packageExceedsOrder = orderQty > 0 && pkg > orderQty;
    var koliIciBlocked = remainingInside is 0;
    var koliUstuValid = selected is not null && pkg > 0 && Model.KoliUstuQuantity > 0
        && Model.KoliUstuQuantity % pkg == 0
        && (orderQty <= 0 || Model.KoliUstuQuantity <= orderQty)
        && (originalPkg <= 0 || pkg <= originalPkg)
        && !packageExceedsOrder;
    var koliUstuCount = koliUstuValid ? (int)(Model.KoliUstuQuantity / pkg) : 0;
    // Koli içi: adet ≥ 1, paket dolu, SAP kalan kota > 0.
    var koliIciValid = selected is not null && pkg > 0 && Model.KoliIciQuantity >= 1
        && (originalPkg <= 0 || pkg <= originalPkg)
        && !koliIciBlocked
        && (remainingInside is null || Model.KoliIciQuantity <= remainingInside.Value);
    var koliIciCount = koliIciValid ? (int)Model.KoliIciQuantity : 0;
    var canReprint = selected is not null && (
        selected.PrintedBoxCount > 0
        || selected.PrintedInsideBoxCount > 0
        || Model.SapSerialsCount > 0
        || Model.RecentPrints.Any(p => p.SapSent || p.Status == FasonBarkod.Core.Enums.BarcodePrintStatus.Printed));
    var isPrintTab = Model.ActiveTab != "reprint" || !canReprint;
}

<nav aria-label="breadcrumb" class="mb-3">    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">SAS</a></li>
        <li class="breadcrumb-item active">@Model.PurchaseOrderNo</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">SAS @Model.PurchaseOrderNo</h1>
        @if (!string.IsNullOrWhiteSpace(Model.CustomerName) || !string.IsNullOrWhiteSpace(Model.VendorCode))
        {
            <p class="text-muted mb-0 small">
                Cari:
                <strong>@(Model.CustomerName ?? Model.VendorCode)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerName) && !string.IsNullOrWhiteSpace(Model.VendorCode))
                {
                    <span class="text-muted">(@Model.VendorCode)</span>
                }
            </p>
        }
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Yeni arama</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 sas-lines-toolbar">
    <span class="text-muted small" id="sasLinesSummary"></span>
    <div class="d-flex align-items-center gap-2">
        <label for="sasLinesPageSize" class="text-muted small mb-0">Sayfa başına</label>
        <select id="sasLinesPageSize" class="form-select form-select-sm" style="width: auto;">
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="0">Tümü</option>
        </select>
    </div>
</div>

<div class="table-responsive mb-2">
    <table class="table table-bordered table-hover align-middle sas-lines-table" id="sasLinesTable">
        <thead class="table-light">
            <tr>
                <th class="sas-sortable" data-sort-key="lineNo" data-sort-type="number">Kalem No <span class="sas-sort-indicator"></span></th>
                <th class="sas-sortable" data-sort-key="materialNumber" data-sort-type="text">Malzeme Kodu <span class="sas-sort-indicator"></span></th>
                <th class="sas-sortable" data-sort-key="materialDescription" data-sort-type="text">Malzeme Açıklaması <span class="sas-sort-indicator"></span></th>
                <th>Birim</th>
                <th class="text-end sas-sortable" data-sort-key="quantity" data-sort-type="number">Miktar <span class="sas-sort-indicator"></span></th>
                <th class="text-end sas-sortable" data-sort-key="packageQuantity" data-sort-type="number">Paket Miktarı <span class="sas-sort-indicator"></span></th>
                <th class="text-end sas-sortable" data-sort-key="printedBoxCount" data-sort-type="number">Basılan Koli <span class="sas-sort-indicator"></span></th>
                <th class="text-end sas-sortable" data-sort-key="printedInsideBoxCount" data-sort-type="number">Basılan Koli İçi <span class="sas-sort-indicator"></span></th>
                <th>Cari</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var line in Model.Lines)
        {
            var isSelected = line.LineNo == Model.SelectedLineNo;
            var lineNoSortValue = int.TryParse(line.LineNo, out var parsedLineNo) ? parsedLineNo : int.MaxValue;
            <tr class="@(isSelected ? "table-warning" : null)"
                data-line-no="@lineNoSortValue"
                data-material-number="@line.MaterialNumber"
                data-material-description="@line.MaterialDescription"
                data-quantity="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-package-quantity="@line.PackageQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                data-printed-box-count="@line.PrintedBoxCount"
                data-printed-inside-box-count="@line.PrintedInsideBoxCount">
                <td>@line.LineNo</td>
                <td>@line.MaterialNumber</td>
                <td>@line.MaterialDescription</td>
                <td>@line.Unit</td>
                <td class="text-end">@line.Quantity.ToString("N0")</td>
                <td class="text-end">@line.PackageQuantity.ToString("N0")</td>
                <td class="text-end">@line.PrintedBoxCount</td>
                <td class="text-end">@line.PrintedInsideBoxCount</td>
                <td>
                    @{
                        var cariDisplay = !string.IsNullOrWhiteSpace(line.CustomerName)
                            ? line.CustomerName
                            : !string.IsNullOrWhiteSpace(line.VendorCode)
                                ? line.VendorCode
                                : Model.VendorCode;
                    }
                    @(string.IsNullOrWhiteSpace(cariDisplay) ? "—" : cariDisplay)
                </td>
                <td class="text-end">
                    <a class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-success")"
                       asp-action="Detail"
                       asp-route-id="@Model.PurchaseOrderNo"
                       asp-route-vendorCode="@(Model.VendorCode ?? line.VendorCode)"
                       asp-route-lineNo="@line.LineNo"
                       asp-route-tab="@Model.ActiveTab">
                        @(isSelected ? "Seçili" : "Seç")
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-between align-items-center mb-3 sas-lines-pager" id="sasLinesPager">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="sasLinesPrev">‹ Önceki</button>
    <span class="text-muted small" id="sasLinesPageIndicator"></span>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="sasLinesNext">Sonraki ›</button>
</nav>

<div class="row g-3 sas-print-panel align-items-start">
    <div class="col-lg-5 d-flex flex-column gap-3">
        <div class="card shadow-sm sas-order-info">            <div class="card-header fw-semibold">SİPARİŞ BİLGİLERİ</div>
            <div class="card-body">
                @if (selected is null)
                {
                    <p class="text-muted mb-0">Etiket basmak için tablodan bir kalem seçin.</p>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-5">SAS No</dt>
                        <dd class="col-sm-7">@Model.PurchaseOrderNo</dd>
                        <dt class="col-sm-5">Cari / Satıcı</dt>
                        <dd class="col-sm-7">
                            @{
                                var vendorDisplay = !string.IsNullOrWhiteSpace(Model.CustomerName)
                                    ? Model.CustomerName
                                    : !string.IsNullOrWhiteSpace(Model.VendorCode)
                                        ? Model.VendorCode
                                        : !string.IsNullOrWhiteSpace(selected.CustomerName)
                                            ? selected.CustomerName
                                            : selected.VendorCode;
                                var vendorCodeDisplay = !string.IsNullOrWhiteSpace(Model.VendorCode)
                                    ? Model.VendorCode
                                    : selected.VendorCode;
                            }
                            @(string.IsNullOrWhiteSpace(vendorDisplay) ? "—" : vendorDisplay)
                            @if (!string.IsNullOrWhiteSpace(vendorDisplay) && !string.IsNullOrWhiteSpace(vendorCodeDisplay)
                                 && !string.Equals(vendorDisplay, vendorCodeDisplay, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="text-muted small"> (@vendorCodeDisplay)</span>
                            }
                        </dd>
                        <dt class="col-sm-5">Kalem</dt>
                        <dd class="col-sm-7">@selected.LineNo</dd>
                        <dt class="col-sm-5">Malzeme</dt>
                        <dd class="col-sm-7">@selected.MaterialNumber</dd>
                        <dt class="col-sm-5">Açıklama</dt>
                        <dd class="col-sm-7">@selected.MaterialDescription</dd>
                        <dt class="col-sm-5">Miktar</dt>
                        <dd class="col-sm-7">@selected.Quantity.ToString("N0") @selected.Unit</dd>
                        <dt class="col-sm-5">Paket Miktarı</dt>
                        <dd class="col-sm-7">@selected.PackageQuantity.ToString("N0")</dd>
                        <dt class="col-sm-5">Basılan Koli</dt>
                        <dd class="col-sm-7">@selected.PrintedBoxCount</dd>
                        <dt class="col-sm-5">Basılan Koli İçi</dt>
                        <dd class="col-sm-7">@selected.PrintedInsideBoxCount</dd>
                        <dt class="col-sm-5">Koli üstü üst sınır</dt>
                        <dd class="col-sm-7">
                            <strong>@selected.Quantity.ToString("N0")</strong>
                            <span class="text-muted small">(MENGE — basılacak ≤ bu, paket katı)</span>
                        </dd>
                        <dt class="col-sm-5">Koli içi kalan</dt>
                        <dd class="col-sm-7">
                            @if (remainingInside is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (remainingInside == 0)
                            {
                                <strong class="text-danger">0</strong>
                                <span class="text-muted small">(basılamaz)</span>
                            }
                            else
                            {
                                <strong>@remainingInside.Value.ToString("N0")</strong>
                            }
                        </dd>
                    </dl>
                }
            </div>
        </div>

        <!--@if (selected is not null)
        {
            <div class="alert alert-info small mb-0">
                <strong>Etiket kuralları</strong>
                <ul class="mb-0 ps-3">
                    <li><strong>Paket miktarı:</strong> SAP'ten otomatik gelir; normalde değiştirmeyin. İstisna durumda "Düzenle" ile açılır.</li>
                    <li><strong>Koli üstü:</strong> Girilen miktar paket miktarının tam katı olmalıdır. Örn. paket 10, miktar 10 → <strong>1</strong> koli üstü etiketi (KOLİ 10 ADET).</li>
                    <li><strong>Koli içi:</strong> Girilen miktar kadar bağımsız etiket basılır. SAP “Max: 0” derse bu kalemde kalan koli içi kotası yoktur (çoğu zaman sipariş miktarı koli üstü ile dolmuştur).</li>
                    <li><strong>Örnek (sipariş 25, paket 10):</strong> Koli üstü için <strong>20</strong> girin → 2 tam koli etiketi. Kalan 5 adet için <strong>koli içi</strong> alanına <strong>25</strong> (veya sadece 5) girerek ürün etiketlerini basın.</li>
                    <li><strong>Butonlar:</strong> SAP'ten barkod alır, .prn şablonu doldurur ve SATO yazıcıya gönderir.</li>
                </ul>
            </div>
        }
        -->
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">            <div class="card-header p-0">
                <ul class="nav nav-tabs card-header-tabs sas-print-tabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link @(isPrintTab ? "active" : "")" data-bs-toggle="tab" data-bs-target="#etiket-yazdir" type="button"
                                @(selected is null ? "disabled" : null)>ETİKET YAZDIR</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(!isPrintTab ? "active" : "")" data-bs-toggle="tab" data-bs-target="#yeniden-etiket-yazdir" type="button"
                                title="@(canReprint ? null : "Bu kalemde henüz basılmış etiket yok.")"
                                disabled="@(!canReprint)">YENİDEN ETİKET YAZDIR</button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content">
                <div class="tab-pane fade @(isPrintTab ? "show active" : "")" id="etiket-yazdir">
                    @if (selected is null)
                    {
                        <p class="text-muted mb-0">Kalem seçilmedi.</p>
                    }
                    else
                    {
                        <div asp-validation-summary="All" class="text-danger small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                        <input type="hidden" id="sapOriginalPackageQuantity" value="@originalPkg.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="sapOrderQuantity" value="@orderQty.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="sapPrintedBoxCount" value="@printedBox.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="sapPrintedInsideCount" value="@printedInside.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="sapRemainingInside" value="@(remainingInside?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />

                        <div class="row g-3 align-items-end mb-3">
                            <div class="col-md-5">
                                <label asp-for="PackageQuantity" class="form-label"></label>
                                <div class="input-group">
                                    @if (isAdmin)
                                    {
                                        <input asp-for="PackageQuantity" class="form-control sas-package-qty" id="packageQtyDisplay"
                                               data-val="false" step="any" min="0.0001" />
                                        <button type="button" class="btn btn-outline-secondary" id="resetPackageQty" title="SAP paket miktarına dön">SAP</button>
                                    }
                                    else
                                    {
                                        <input asp-for="PackageQuantity" class="form-control sas-package-qty" id="packageQtyDisplay"
                                               data-val="false" step="any" min="0.0001" readonly tabindex="-1" />
                                    }
                                </div>
                                <div class="form-text">
                                    @if (isAdmin)
                                    {
                                        <text>En fazla SAP paket: <strong>@originalPkg.ToString("N0")</strong> (daha büyük olamaz; düşürülebilir). Düzenlediğiniz değer basımda SAP’ye gider.</text>
                                    }
                                    else
                                    {
                                        <text>Paket miktarını değiştiremezsiniz. Değişiklik için amirinize söyleyin.</text>
                                    }
                                    @if (packageExceedsOrder && isAdmin)
                                    {
                                        <span class="text-danger d-block">Sipariş @orderQty.ToString("N0"), paket @pkg.ToString("N0") — paketi @orderQty.ToString("N0") veya altına düşürün.</span>
                                    }
                                </div>
                                <input type="hidden" asp-for="OriginalPackageQuantity" />
                                <input type="hidden" asp-for="OrderQuantity" />
                            </div>
                        </div>

                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <form asp-action="PrintKoliUstu" method="post" class="sas-print-form" novalidate>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="PurchaseOrderNo" />
                                    <input type="hidden" asp-for="VendorCode" />
                                    <input type="hidden" asp-for="SelectedLineNo" />
                                    <input type="hidden" asp-for="LineNo" />
                                    <input type="hidden" asp-for="MaterialNumber" />
                                    <input type="hidden" asp-for="MaterialDescription" />
                                    <input type="hidden" asp-for="OriginalPackageQuantity" />
                                    <input type="hidden" asp-for="OrderQuantity" />
                                    <input type="hidden" asp-for="PackageQuantity" class="sas-package-qty-hidden" />
                                    <label asp-for="KoliUstuQuantity" class="form-label"></label>
                                    <input asp-for="KoliUstuQuantity" id="koliUstuQtyInput" class="form-control mb-2" data-val="false" step="any" min="0.0001"
                                           data-qty-rule="box-top" />
                                    <div id="koliUstuFeedback" class="form-text mb-2">
                                        @if (koliUstuValid)
                                        {
                                            <text>→ @koliUstuCount Adet koli üstü etiketi (örn. paket 10, miktar 10 → 1 etiket)</text>
                                        }
                                        else if (pkg > 0 && Model.KoliUstuQuantity > 0 && Model.KoliUstuQuantity % pkg != 0)
                                        {
                                            <span class="text-danger">Girilen Değer, Paket Miktarının Katı Olmalıdır.!</span>
                                        }
                                        else if (orderQty > 0 && Model.KoliUstuQuantity > orderQty)
                                        {
                                            <span class="text-danger">Sipariş miktarını (@orderQty.ToString("N0")) aşamaz.</span>
                                        }
                                        else if (orderQty > 0 && pkg > orderQty)
                                        {
                                            <span class="text-muted">Miktar @orderQty.ToString("N0") &lt; paket @pkg.ToString("N0") — paketi düşürüp basabilirsiniz.</span>
                                        }
                                    </div>
                                    <button type="submit" id="koliUstuSubmitBtn" class="btn btn-warning w-100 sas-submit-btn" disabled="@(!koliUstuValid)">Koli Üstü Barkodu</button>
                                </form>
                            </div>

                            <div class="col-md-4">
                                <form asp-action="PrintKoliIci" method="post" class="sas-print-form" novalidate>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="PurchaseOrderNo" />
                                    <input type="hidden" asp-for="VendorCode" />
                                    <input type="hidden" asp-for="SelectedLineNo" />
                                    <input type="hidden" asp-for="LineNo" />
                                    <input type="hidden" asp-for="MaterialNumber" />
                                    <input type="hidden" asp-for="MaterialDescription" />
                                    <input type="hidden" asp-for="OriginalPackageQuantity" />
                                    <input type="hidden" asp-for="OrderQuantity" />
                                    <input type="hidden" asp-for="PackageQuantity" class="sas-package-qty-hidden" />
                                    <label asp-for="KoliIciQuantity" class="form-label"></label>
                                    <input asp-for="KoliIciQuantity" id="koliIciQtyInput" class="form-control mb-2" data-val="false" step="any" min="1"
                                           data-qty-rule="box-inside"
                                           disabled="@koliIciBlocked" />
                                    <div id="koliIciFeedback" class="form-text mb-2">
                                        @if (koliIciBlocked)
                                        {
                                            <span class="text-danger">Koli içi basılamaz (kalan kota: 0).</span>
                                        }
                                        else if (koliIciValid)
                                        {
                                            <text>→ @koliIciCount adet koli içi etiketi@(remainingInside is > 0 ? $" (kalan en fazla {remainingInside.Value:0.####})" : "")</text>
                                            @if (packageExceedsOrder)
                                            {
                                                <span class="text-muted d-block">Not: formdaki paket @pkg.ToString("N0"); SAP'ye koli içi için @pkgForInside.ToString("N0") gider.</span>
                                            }
                                        }
                                        else if (remainingInside is > 0 && Model.KoliIciQuantity > remainingInside)
                                        {
                                            <span class="text-danger">Kalan koli içi kotası en fazla @remainingInside.Value.ToString("N0").</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Basılacak adet ≥ 1 ve paket &gt; 0 olmalı.</span>
                                        }
                                    </div>
                                    <button type="submit" id="koliIciSubmitBtn" class="btn btn-warning w-100 sas-submit-btn"
                                            disabled="@(!koliIciValid)"
                                            title="@(koliIciBlocked ? "Kalan koli içi kotası 0" : null)">Koli İçi Barkodu</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade @(!isPrintTab ? "show active" : "")" id="yeniden-etiket-yazdir">
                    @if (selected is null)
                    {
                        <p class="text-muted mb-0">Kalem seçilmedi.</p>
                    }
                    else if (!canReprint)
                    {
                        <p class="text-muted mb-0">Bu kalemde henüz basılmış etiket yok. Önce <strong>Etiket Yazdır</strong> ile basım yapın.</p>
                    }
                    else
                    {
                        <div asp-validation-summary="All" class="text-danger small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                        <p class="text-muted small mb-2">
                            SAP <code>ZMMIST14000</code> serilerinden seçip aynı SERNR ile tekrar basar.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.SapSerialsError) && Model.SapSerialsCount == 0)
                        {
                            <div class="alert alert-warning py-2 small">@Model.SapSerialsError</div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="fw-semibold small mb-1">Koli üstü — Seri No</div>
                                <div class="table-responsive border" style="max-height: 220px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Seri No</th>
                                                <th style="width:4rem;">Okundu</th>
                                            </tr>
                                        </thead>
                                        <tbody id="sapSerialsBoxTopBody">
                                        @if (Model.SapSerialsBoxTop.Count == 0)
                                        {
                                            <tr><td colspan="2" class="text-muted small">Koli üstü seri yok.</td></tr>
                                        }
                                        else
                                        {
                                            foreach (var s in Model.SapSerialsBoxTop)
                                            {
                                                var sel = string.Equals(s.SerialNumber, Model.SerialNumber, StringComparison.OrdinalIgnoreCase);
                                                <tr class="sas-serial-row @(sel ? "table-warning" : "")" data-sernr="@s.SerialNumber" data-kind="top" style="cursor:pointer;">
                                                    <td class="font-monospace fw-semibold">@s.SerialNumber</td>
                                                    <td></td>
                                                </tr>
                                            }
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fw-semibold small mb-1">Koli içi — Seri No</div>
                                <div class="table-responsive border" style="max-height: 220px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Seri No</th>
                                                <th style="width:4rem;">Okundu</th>
                                            </tr>
                                        </thead>
                                        <tbody id="sapSerialsBoxInsideBody">
                                        @if (Model.SapSerialsBoxInside.Count == 0)
                                        {
                                            <tr><td colspan="2" class="text-muted small">Koli içi seri yok.</td></tr>
                                        }
                                        else
                                        {
                                            foreach (var s in Model.SapSerialsBoxInside)
                                            {
                                                var sel = string.Equals(s.SerialNumber, Model.SerialNumber, StringComparison.OrdinalIgnoreCase);
                                                <tr class="sas-serial-row @(sel ? "table-warning" : "")" data-sernr="@s.SerialNumber" data-kind="inside" style="cursor:pointer;">
                                                    <td class="font-monospace fw-semibold">@s.SerialNumber</td>
                                                    <td></td>
                                                </tr>
                                            }
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="SerialNumber" id="serialNumberInput" class="sas-sernr-hidden" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <form asp-action="ReprintKoliUstu" method="post" class="sas-reprint-form" novalidate>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="PurchaseOrderNo" />
                                    <input type="hidden" asp-for="VendorCode" />
                                    <input type="hidden" asp-for="SelectedLineNo" />
                                    <input type="hidden" asp-for="LineNo" />
                                    <input type="hidden" asp-for="MaterialNumber" />
                                    <input type="hidden" asp-for="MaterialDescription" />
                                    <input type="hidden" asp-for="PackageQuantity" class="sas-package-qty-hidden" />
                                    <input type="hidden" asp-for="SerialNumber" class="sas-sernr-hidden" />
                                    <button type="submit" class="btn btn-warning w-100 sas-submit-btn" disabled="@(!canReprint)">Koli Üstü Barkodu</button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form asp-action="ReprintKoliIci" method="post" class="sas-reprint-form" novalidate>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="PurchaseOrderNo" />
                                    <input type="hidden" asp-for="VendorCode" />
                                    <input type="hidden" asp-for="SelectedLineNo" />
                                    <input type="hidden" asp-for="LineNo" />
                                    <input type="hidden" asp-for="MaterialNumber" />
                                    <input type="hidden" asp-for="MaterialDescription" />
                                    <input type="hidden" asp-for="PackageQuantity" class="sas-package-qty-hidden" />
                                    <input type="hidden" asp-for="SerialNumber" class="sas-sernr-hidden" />
                                    <button type="submit" class="btn btn-warning w-100 sas-submit-btn" disabled="@(!canReprint)">Koli İçi Barkodu</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.RecentPrints.Count > 0)
{
    <div class="card shadow-sm mt-4 page-content-bottom">        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Basılan Etiketler</span>
            <a class="btn btn-sm btn-outline-primary" asp-controller="BarcodePrints" asp-action="Index">Tüm Basım Geçmişi</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Barkod No</th>
                            <th>Malzeme</th>
                            <th class="text-end">Adet</th>
                            <th>Tarih</th>
                            <th>Basan</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var print in Model.RecentPrints)
                    {
                        var statusLabel = print.Status switch
                        {
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Pending => "Bekliyor",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Printed => "Basıldı",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.SentToSap => "SAP",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Failed => "Hata",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Cancelled => "İptal",
                            _ => print.Status.ToString()
                        };
                        var statusCss = print.Status switch
                        {
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Printed => "success",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.SentToSap => "success",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Failed => "danger",
                            FasonBarkod.Core.Enums.BarcodePrintStatus.Pending => "warning",
                            _ => "secondary"
                        };
                        <tr>
                            <td class="fw-semibold">@print.BarcodeNo</td>
                            <td>@print.MaterialCode</td>
                            <td class="text-end">@print.Quantity.ToString("N0")</td>
                            <td>@print.PrintDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(print.PrintedBy ?? "-")</td>
                            <td>
                                <span class="badge text-bg-@statusCss">@statusLabel</span>
                                @if (!print.SapSent)
                                {
                                    <span class="badge text-bg-secondary" title="SAP'e barkod isteği başarısız oldu; yerel/mock numara ile basıldı.">SAP'e gönderilmedi</span>
                                }
                            </td>
                            <td class="text-end">
                                @{
                                    var reprintSernr = !string.IsNullOrWhiteSpace(print.SerialNumber)
                                        ? print.SerialNumber
                                        : print.BarcodeNo;
                                }
                                <a class="btn btn-sm btn-outline-warning"
                                   asp-action="Detail"
                                   asp-route-id="@Model.PurchaseOrderNo"
                                   asp-route-vendorCode="@Model.VendorCode"
                                   asp-route-lineNo="@(print.LineNo ?? Model.LineNo)"
                                   asp-route-tab="reprint"
                                   asp-route-sernr="@reprintSernr">Tekrar bas</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="BarcodePrints" asp-action="Detail" asp-route-id="@print.Id">Detay</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (selected is not null)
{
    <p class="text-muted mt-4 mb-0 page-content-bottom">
        Bu kalem için uygulama kaydı yok. SAP'ten başarılı barkod alındığında burada görünür.
        SAP tarafındaki basım bilgisi tabloda <strong>Basılan Koli</strong> sütunundadır.
    </p>
}

@section Scripts {
    <script>
        (function () {
            const packageInput = document.getElementById('packageQtyDisplay');
            const serialInput = document.getElementById('serialNumberInput');
            const toggleBtn = document.getElementById('togglePackageQty');
            const hiddenFields = () => document.querySelectorAll('.sas-package-qty-hidden');
            const serialFields = () => document.querySelectorAll('.sas-sernr-hidden');

            function syncPackageQty() {
                if (!packageInput) return;
                hiddenFields().forEach(f => f.value = packageInput.value);
            }

            function syncSerialNumber() {
                if (!serialInput) return;
                serialFields().forEach(f => f.value = serialInput.value);
            }

            const originalPkgEl = document.getElementById('sapOriginalPackageQuantity');
            const orderQtyEl = document.getElementById('sapOrderQuantity');
            const printedBoxEl = document.getElementById('sapPrintedBoxCount');
            const printedInsideEl = document.getElementById('sapPrintedInsideCount');
            const resetPkgBtn = document.getElementById('resetPackageQty');
            const originalPkg = () => parseFloat(originalPkgEl ? originalPkgEl.value : '0') || 0;
            const orderQty = () => parseFloat(orderQtyEl ? orderQtyEl.value : '0') || 0;
            const printedBox = () => parseFloat(printedBoxEl ? printedBoxEl.value : '0') || 0;
            const printedInside = () => parseFloat(printedInsideEl ? printedInsideEl.value : '0') || 0;

            function remainingInsideQty(pkg) {
                const menge = orderQty();
                if (menge <= 0) return null;
                // Koli içi: paket>MENGE ise efektif paket = MENGE.
                const p = pkg > menge ? menge : (pkg > 0 ? pkg : 0);
                const rem = menge - (printedBox() * p) - printedInside();
                return rem < 0 ? 0 : rem;
            }

            // Doqu: koli üstü = paket katı + ≤ MENGE; koli içi = adet ≥ 1 ve kalan kota > 0.
            function validateQtyInput(input, feedbackEl, submitBtn, rule) {
                if (!input || !feedbackEl) return;

                const pkg = parseFloat(packageInput ? packageInput.value : '0') || 0;
                const qty = parseFloat(input.value) || 0;
                const maxPkg = originalPkg();
                const menge = orderQty();
                let valid = false;
                let count = 0;
                let msg = '';

                if (maxPkg > 0 && pkg > maxPkg) {
                    msg = '<span class="text-danger">Girilen Değer, Paket Miktarıdan Büyük Olamaz.</span>';
                } else if (rule === 'box-top') {
                    if (pkg <= 0 || qty <= 0) {
                        msg = '';
                    } else if (menge > 0 && qty > menge) {
                        msg = '<span class="text-danger">Sipariş miktarını (' + menge + ') aşamaz.</span>';
                    } else if (Math.abs(qty % pkg) > 1e-9) {
                        msg = '<span class="text-danger">Girilen Değer, Paket Miktarının Katı Olmalıdır.!</span>';
                    } else {
                        valid = true;
                        count = Math.round(qty / pkg);
                        msg = '→ ' + count + ' Adet koli üstü etiketi';
                    }
                } else if (rule === 'box-inside') {
                    const rem = remainingInsideQty(pkg);
                    if (rem === 0) {
                        msg = '<span class="text-danger">Koli içi basılamaz (kalan kota: 0).</span>';
                        input.disabled = true;
                    } else if (pkg <= 0) {
                        msg = '<span class="text-danger">Lütfen PaKet Miktarını Kontrol Ediniz.</span>';
                        input.disabled = false;
                    } else if (qty < 1) {
                        msg = '<span class="text-danger">Sıfır Olamaz</span>';
                        input.disabled = false;
                    } else if (rem != null && qty > rem) {
                        msg = '<span class="text-danger">Kalan koli içi kotası en fazla ' + rem + '.</span>';
                        input.disabled = false;
                    } else {
                        valid = true;
                        count = Math.round(qty);
                        var sapPkg = (menge > 0 && pkg > menge) ? menge : Math.min(pkg, qty);
                        msg = '→ ' + count + ' adet koli içi etiketi' + (rem != null ? ' (kalan en fazla ' + rem + ')' : '');
                        if (pkg !== sapPkg) {
                            msg += '<span class="text-muted d-block">SAP\'ye paket ' + sapPkg + ' gidecek (sizin ' + count + ' adet isteğiniz).</span>';
                        }
                        input.disabled = false;
                    }
                }

                feedbackEl.innerHTML = msg;
                if (submitBtn) submitBtn.disabled = !valid;
            }

            function wireQtyValidation(inputId, feedbackId, submitBtnId) {
                const input = document.getElementById(inputId);
                const feedbackEl = document.getElementById(feedbackId);
                const submitBtn = document.getElementById(submitBtnId);
                if (!input) return;

                const rule = input.getAttribute('data-qty-rule');
                const run = () => validateQtyInput(input, feedbackEl, submitBtn, rule);
                input.addEventListener('input', run);
                if (packageInput) packageInput.addEventListener('input', run);
                run();
            }

            wireQtyValidation('koliUstuQtyInput', 'koliUstuFeedback', 'koliUstuSubmitBtn');
            wireQtyValidation('koliIciQtyInput', 'koliIciFeedback', 'koliIciSubmitBtn');

            if (packageInput) {
                packageInput.addEventListener('input', syncPackageQty);
                syncPackageQty();
            }
            if (resetPkgBtn && packageInput && originalPkgEl) {
                resetPkgBtn.addEventListener('click', function () {
                    packageInput.value = originalPkgEl.value;
                    syncPackageQty();
                    packageInput.dispatchEvent(new Event('input'));
                });
            }

            document.querySelectorAll('.sas-print-form, .sas-reprint-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    const isReprint = form.classList.contains('sas-reprint-form');
                    if (isReprint) {
                        syncSerialNumber();
                        const sn = (document.getElementById('serialNumberInput') || {}).value || '';
                        if (!String(sn).trim()) {
                            e.preventDefault();
                            alert('Önce listeden bir SERNR seçin.');
                            return;
                        }
                    }

                    const qtyInput = form.querySelector('[data-qty-rule]');
                    if (qtyInput) {
                        const pkg = parseFloat(packageInput ? packageInput.value : '0') || 0;
                        const qty = parseFloat(qtyInput.value) || 0;
                        const rule = qtyInput.getAttribute('data-qty-rule');
                        const maxPkg = originalPkg();
                        const menge = orderQty();
                        let valid = false;
                        if (maxPkg > 0 && pkg > maxPkg) valid = false;
                        else if (rule === 'box-top') {
                            valid = pkg > 0 && qty > 0 && Math.abs(qty % pkg) < 1e-9 && (menge <= 0 || qty <= menge);
                        }                         else if (rule === 'box-inside') {
                            const rem = remainingInsideQty(pkg);
                            valid = rem !== 0 && pkg > 0 && qty >= 1 && (rem == null || qty <= rem);
                        }
                        if (!valid) {
                            e.preventDefault();
                            return;
                        }
                    }

                    syncPackageQty();
                    syncSerialNumber();
                    const btn = form.querySelector('.sas-submit-btn') || form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.textContent = 'SAP\'e gönderiliyor...';
                    }
                });
            });

            const feedback = document.getElementById('print-feedback');
            if (feedback) feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            function selectSernr(sernr) {
                if (!sernr) return;
                document.querySelectorAll('.sas-sernr-hidden, #serialNumberInput').forEach(function (f) {
                    f.value = sernr;
                });
                document.querySelectorAll('tr.sas-serial-row').forEach(function (row) {
                    row.classList.toggle('table-warning', row.getAttribute('data-sernr') === sernr);
                });
            }

            document.querySelectorAll('tr.sas-serial-row').forEach(function (row) {
                row.addEventListener('click', function () {
                    selectSernr(row.getAttribute('data-sernr'));
                });
            });
            syncSerialNumber();
        })();

        (function () {
            const table = document.getElementById('sasLinesTable');
            if (!table) return;

            const tbody = table.querySelector('tbody');
            const allRows = Array.from(tbody.querySelectorAll('tr'));
            const pageSizeSelect = document.getElementById('sasLinesPageSize');
            const prevBtn = document.getElementById('sasLinesPrev');
            const nextBtn = document.getElementById('sasLinesNext');
            const pageIndicator = document.getElementById('sasLinesPageIndicator');
            const summary = document.getElementById('sasLinesSummary');
            const pager = document.getElementById('sasLinesPager');

            const dataKeyByColumn = {
                lineNo: 'lineNo',
                materialNumber: 'materialNumber',
                materialDescription: 'materialDescription',
                quantity: 'quantity',
                packageQuantity: 'packageQuantity',
                printedBoxCount: 'printedBoxCount',
                printedInsideBoxCount: 'printedInsideBoxCount'
            };

            let sortKey = 'lineNo';
            let sortType = 'number';
            let sortAsc = true;
            let currentPage = 1;
            let pageSize = parseInt(pageSizeSelect ? pageSizeSelect.value : '20', 10) || 20;

            function rowValue(row, key) {
                const attr = 'data-' + key.replace(/([A-Z])/g, '-$1').toLowerCase();
                return row.getAttribute(attr) ?? '';
            }

            function sortRows() {
                allRows.sort(function (a, b) {
                    const va = rowValue(a, dataKeyByColumn[sortKey]);
                    const vb = rowValue(b, dataKeyByColumn[sortKey]);
                    let cmp;
                    if (sortType === 'number') {
                        cmp = (parseFloat(va) || 0) - (parseFloat(vb) || 0);
                    } else {
                        cmp = va.localeCompare(vb, 'tr', { sensitivity: 'base' });
                    }
                    return sortAsc ? cmp : -cmp;
                });
            }

            function updateSortIndicators() {
                table.querySelectorAll('th.sas-sortable').forEach(function (th) {
                    const indicator = th.querySelector('.sas-sort-indicator');
                    if (!indicator) return;
                    if (th.getAttribute('data-sort-key') === sortKey) {
                        indicator.textContent = sortAsc ? '▲' : '▼';
                    } else {
                        indicator.textContent = '';
                    }
                });
            }

            function render() {
                sortRows();
                updateSortIndicators();

                const total = allRows.length;
                const effectivePageSize = pageSize > 0 ? pageSize : total;
                const totalPages = effectivePageSize > 0 ? Math.max(1, Math.ceil(total / effectivePageSize)) : 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const start = pageSize > 0 ? (currentPage - 1) * pageSize : 0;
                const end = pageSize > 0 ? start + pageSize : total;

                tbody.innerHTML = '';
                allRows.forEach(function (row, index) {
                    if (index >= start && index < end) {
                        tbody.appendChild(row);
                    }
                });

                if (summary) {
                    summary.textContent = total === 0
                        ? 'Kalem yok'
                        : `${total} kalemden ${Math.min(start + 1, total)}–${Math.min(end, total)} arası gösteriliyor`;
                }

                if (pageIndicator) {
                    pageIndicator.textContent = `Sayfa ${currentPage} / ${totalPages}`;
                }

                if (prevBtn) prevBtn.disabled = currentPage <= 1;
                if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
                if (pager) pager.style.display = (pageSize > 0 && totalPages > 1) ? '' : 'none';
            }

            function goToSelectedPage() {
                sortRows();
                const selectedIdx = allRows.findIndex(function (row) {
                    return row.classList.contains('table-warning');
                });
                if (selectedIdx < 0 || pageSize <= 0) {
                    currentPage = 1;
                    return;
                }
                currentPage = Math.floor(selectedIdx / pageSize) + 1;
            }

            table.querySelectorAll('th.sas-sortable').forEach(function (th) {
                th.style.cursor = 'pointer';
                th.addEventListener('click', function () {
                    const key = th.getAttribute('data-sort-key');
                    const type = th.getAttribute('data-sort-type') || 'text';
                    if (sortKey === key) {
                        sortAsc = !sortAsc;
                    } else {
                        sortKey = key;
                        sortType = type;
                        sortAsc = true;
                    }
                    goToSelectedPage();
                    render();
                });
            });

            if (pageSizeSelect) {
                pageSizeSelect.addEventListener('change', function () {
                    pageSize = parseInt(pageSizeSelect.value, 10) || 0;
                    goToSelectedPage();
                    render();
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    currentPage -= 1;
                    render();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    currentPage += 1;
                    render();
                });
            }

            goToSelectedPage();
            render();
        })();
    </script>
}